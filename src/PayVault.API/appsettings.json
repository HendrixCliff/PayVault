{
   "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};SslMode=${DB_SSL_MODE};Trust Server Certificate=${DB_TRUST_SERVER_CERT}"
  },
"Jwt": {
  "Key": "PayVaultSuperSecretKeyMinimum32CharactersLongForHS256Algorithm2024SuperSecureKey1234567890",
  "Issuer": "PayVaultAPI",
  "Audience": "PayVaultClient"
},
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}